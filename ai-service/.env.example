# Service Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model Configuration
# Path to local YOLO weights or HuggingFace repo / model name
MODEL_PATH=models/pothole_road_damage_best.pt
FALLBACK_MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
MAX_IMAGE_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# OCR Configuration (Optional PaddleOCR / EasyOCR / PyTesseract)
ENABLE_OCR=true
OCR_LANGUAGES=en
